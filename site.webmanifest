{
  "id": "/briefings/index.html",
  "name": "Daily Briefing",
  "short_name": "Briefing",
  "description": "Hermes daily briefing: news, markets, sport and dev releases",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#100f0d",
  "theme_color": "#100f0d",
  "categories": ["news"],
  "icons": [
    { "src": "app/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "app/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "app/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "app/icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Scores & fixtures", "short_name": "Sports", "url": "./app/#/sports", "icons": [{ "src": "app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved stories", "short_name": "Saved", "url": "./app/#/saved", "icons": [{ "src": "app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Archive", "short_name": "Archive", "url": "./app/#/archive", "icons": [{ "src": "app/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
